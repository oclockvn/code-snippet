<Window x:Class="CodeSnippet.Views.SearchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CodeSnippet.ViewModels"
        xmlns:behaviors="clr-namespace:CodeSnippet.Behaviors"
        Title="Prompt Manager"
        Width="720"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Icon="pack://application:,,,/Resources/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- One result row: a clickable item row with name-highlight, plus its containing folder. -->
        <DataTemplate DataType="{x:Type vm:SearchResultRow}">
            <Button Command="{Binding DataContext.ChooseRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Padding="20,11" BorderThickness="4,0,0,0"
                                BorderBrush="{StaticResource DarkDividerFaint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NumberText" Grid.Column="0" Text="{Binding DisplayNumber}"
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}"
                                           VerticalAlignment="Top" TextAlignment="Right" Margin="0,3,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Neutral200}"
                                               behaviors:TitleHighlightBehavior.Segments="{Binding TitleSegments, Mode=OneWay}"/>
                                    <TextBlock x:Name="FolderText" Text="{Binding FolderPath}" FontSize="12"
                                               Foreground="{StaticResource Neutral500}" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasFolderPath, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#0AF8F4F4"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource ColorAccent}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Neutral100}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Neutral100}"/>
                                <Setter TargetName="FolderText" Property="Foreground" Value="#D8F8F4F4"/>
                                <Setter TargetName="NumberText" Property="Foreground" Value="#BFF8F4F4"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

    </Window.Resources>

    <Border Background="{StaticResource DarkBg}" BorderBrush="{StaticResource ColorAccent}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <!-- The window's content doesn't change shape while shown, so cache the blurred-shadow render
             to a bitmap instead of re-rasterizing the effect on every frame. -->
        <Border.CacheMode>
            <BitmapCache/>
        </Border.CacheMode>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- red top rule -->
            <Rectangle Grid.Row="0" Fill="{StaticResource ColorAccent}"/>

            <!-- header: icon + query + count badge -->
            <Grid Grid.Row="1" Margin="20,16" Visibility="{Binding IsHeaderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="10" Height="24" Fill="{StaticResource ColorAccent}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Search vault" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Neutral700}"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsQueryEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22" FontWeight="SemiBold" Background="Transparent"
                             Foreground="{StaticResource Neutral100}" CaretBrush="{StaticResource ColorAccent}"
                             BorderThickness="0" Padding="0"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding CountBadgeText}" Foreground="{StaticResource Neutral600}"
                           FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>

            <!-- body: results list -->
            <ScrollViewer Grid.Row="2" MaxHeight="480" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Rows}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DarkDividerFaint}"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- no-match state -->
            <StackPanel Grid.Row="2" Margin="24,20" MinWidth="672"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=NoMatch}">
                <TextBlock Text="Nothing matches that." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Neutral200}" Margin="0,0,0,6"/>
                <TextBlock Text="Keep typing to widen the search." FontSize="12.5" Foreground="{StaticResource Neutral500}" MaxWidth="480"/>
            </StackPanel>

            <!-- first-run state -->
            <StackPanel Grid.Row="2" Margin="24,26,24,8" MinWidth="672"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=FirstRun}">
                <TextBlock Text="NO VAULT CONFIGURED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent400}" Margin="0,0,0,10"/>
                <TextBlock Text="Point this at your Obsidian vault, then search notes by name." FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource Neutral100}" TextWrapping="Wrap" MaxWidth="500" Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,14,16,14">
                        <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBlock Text="Open Settings and choose your vault folder." FontSize="12.5"
                                   Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,14,16,14">
                        <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBlock Text="Hit Shift + Alt + J anywhere and type a few letters." FontSize="12.5"
                                   Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,14,0,14">
                        <TextBlock Text="03" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBlock Text="Enter previews a note; Ctrl + Enter copies it, then paste with Ctrl + V." FontSize="12.5"
                                   Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="⏎  Open Settings" Style="{StaticResource BtnPrimary}"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- copied confirmation -->
            <Grid Grid.Row="2" MinWidth="672"
                  Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Copied}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="10" Height="52" Fill="{StaticResource ColorAccent}" Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="COPIED TO CLIPBOARD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent400}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CopiedTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Neutral100}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="NOW PRESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral500}" HorizontalAlignment="Right"/>
                        <TextBlock Text="Ctrl + V" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Neutral100}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Fill="{StaticResource ColorAccent}"/>
            </Grid>

            <!-- inline preview: opened with Enter, follows whatever row is currently highlighted -->
            <Border Grid.Row="3" BorderBrush="{StaticResource DarkDividerFaint}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SelectedFile.Name}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource Neutral200}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="Copy" Style="{StaticResource BtnGhost}" Padding="10,4" FontSize="10.5"
                                Command="{Binding CopySelectedCommand}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                        </ScrollViewer.Resources>
                        <TextBox Text="{Binding PreviewContent, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                 Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 IsReadOnly="True" IsUndoEnabled="False" UndoLimit="0"
                                 SelectionBrush="{StaticResource ColorAccent}"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- footer: keybind hints + status (Resting / Typing) -->
            <Border Grid.Row="4" BorderBrush="{StaticResource DarkDividerFaint}" BorderThickness="0,1,0,0" Padding="20,10"
                    Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↑ ↓  Move" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,16,0"/>
                    <TextBlock Text="⏎  Preview" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,16,0"
                               Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    <TextBlock Text="Ctrl + ⏎  Copy" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,16,0"/>
                    <TextBlock Text="Esc  Close" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,16,0"
                               Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    <TextBlock Text="Esc  Back" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,16,0"
                               Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent400}"/>
                </StackPanel>
            </Border>

            <!-- footer: no-match hints -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="20,10"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=NoMatch}">
                <TextBlock Text="Esc  Close" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}"/>
            </StackPanel>

            <!-- footer: first-run hints -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="20,10"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=FirstRun}">
                <TextBlock Text="Esc  Close" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}"/>
            </StackPanel>

            <!-- footer: settings shortcut — sits on top of whichever footer above is active -->
            <Button Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                    Style="{StaticResource BtnIconGhost}" Command="{Binding OpenSettingsCommand}"
                    ToolTip="Settings">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M12 15a3 3 0 100-6 3 3 0 000 6z M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82A1.65 1.65 0 003 13.09H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                    </Canvas>
                </Viewbox>
            </Button>

        </Grid>
    </Border>
</Window>
