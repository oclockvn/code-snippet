<Window x:Class="CodeSnippet.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Manager — Library" Height="600" Width="960" MinHeight="460" MinWidth="760"
        Background="{StaticResource ColorBg}"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource ColorText}" BorderThickness="0,0,0,2" Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="13" Height="13" Fill="{StaticResource ColorAccent}" Margin="0,0,11,0"/>
                    <TextBlock Text="PROMPT MANAGER — LIBRARY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,11,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Neutral600}" VerticalAlignment="Center">
                        <Run Text="{Binding Prompts.Count, Mode=OneWay}"/><Run Text=" prompts"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Import" Style="{StaticResource BtnGhost}" Command="{Binding ImportCommand}"/>
                    <Button Content="Export" Style="{StaticResource BtnGhost}" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- populated library: filter/sort + list, editor -->
        <Grid Grid.Row="1" Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,1,1" Padding="12">
                    <TextBox Style="{StaticResource InputStyle}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <ListBox Grid.Row="1" BorderThickness="0,0,1,0" BorderBrush="{StaticResource ColorDivider}"
                          Background="{StaticResource ColorBg}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ItemsSource="{Binding Prompts}" SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="4,0,0,1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Accent200}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,3,0,0">
                                    <Run Text="{Binding UsageCount, Mode=OneWay}"/><Run Text="×"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" BorderBrush="{StaticResource ColorText}" BorderThickness="0,2,1,0" Padding="12,13">
                    <Button Content="New prompt  ·  Ctrl + N" Style="{StaticResource BtnSecondary}" HorizontalContentAlignment="Left"
                            HorizontalAlignment="Stretch" Command="{Binding NewCommand}"/>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,20" >
                    <TextBlock Text="TITLE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" FontSize="16" FontWeight="SemiBold"
                             Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="BODY" HorizontalAlignment="Left" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Neutral600}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource Neutral500}">
                            <Run Text="{Binding EditBody.Length, Mode=OneWay}"/><Run Text=" characters · plain text"/>
                        </TextBlock>
                    </Grid>
                    <TextBox Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12.5" Padding="12,10"
                             Background="{StaticResource Neutral100}" BorderBrush="{StaticResource ColorDivider}" BorderThickness="1"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Height="230" Margin="0,0,0,16"/>

                    <TextBlock Text="TAGS — COMMA SEPARATED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPrompt}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="USED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Neutral600}"/>
                            <TextBlock FontSize="15" FontWeight="Bold" Margin="0,2,0,0">
                                <Run Text="{Binding SelectedPrompt.UsageCount, Mode=OneWay}"/><Run Text=" times"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="LAST USED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Neutral600}"/>
                            <TextBlock Text="{Binding SelectedPrompt.LastUsedAt, Mode=OneWay, Converter={StaticResource RelativeTimeConverter}, ConverterParameter=Sentence}"
                                       FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CREATED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Neutral600}"/>
                            <TextBlock Text="{Binding SelectedPrompt.CreatedAt, Mode=OneWay, StringFormat='d MMM yyyy'}"
                                       FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="{StaticResource ColorText}" BorderThickness="0,2,0,0" Padding="24,13">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save  ·  Ctrl + S" Style="{StaticResource BtnPrimary}" Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
                            <Button Content="Delete" Style="{StaticResource BtnSecondary}" Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent700}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- empty library onboarding -->
        <StackPanel Grid.Row="1" Margin="40" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="EMPTY LIBRARY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorAccent}" Margin="0,0,0,12"/>
            <TextBlock Text="Put the prompts you retype most in here." FontSize="30" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border Height="2" Background="{StaticResource ColorDivider}" Margin="0,0,0,18"/>
            <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource Neutral800}" Margin="0,0,0,24">
                A prompt is a title, a body and some tags. The title is what you will search for, so write it the way you would say it out loud.
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Button Content="New prompt" Style="{StaticResource BtnPrimary}" Command="{Binding NewCommand}" Margin="0,0,10,0"/>
                <Button Content="Import JSON" Style="{StaticResource BtnSecondary}" Command="{Binding ImportCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
