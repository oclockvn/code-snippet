<Window x:Class="CodeSnippet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="480" Width="480"
        Background="{StaticResource ColorBg}"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource ColorText}" BorderThickness="0,0,0,2" Padding="18,13">
            <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,20">

            <TextBlock Text="VAULT FOLDER" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,8"/>
            <TextBox Text="{Binding VaultPath, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputStyle}" FontSize="12.5"/>
            <TextBlock Text="Only .md files under this folder are searched by name; folders starting with a dot (.obsidian, .trash, .git, ...) are skipped."
                       Foreground="{StaticResource Neutral600}" FontSize="11.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Browse..." Style="{StaticResource BtnSecondary}" Command="{Binding BrowseVaultFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="Open in folder" Style="{StaticResource BtnGhost}" Command="{Binding OpenVaultFolderCommand}"/>
            </StackPanel>

            <Border Height="2" Background="{StaticResource ColorDivider}" Margin="0,20"/>

            <TextBlock Text="GLOBAL HOTKEY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,8"/>
            <TextBox x:Name="HotkeyBox"
                     Text="{Binding HotkeyDisplay, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource InputStyle}"
                     FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent700}"
                     BorderBrush="{StaticResource ColorAccent}" Background="{StaticResource Accent100}"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <TextBlock Text="Click the box above, then press the new key combination. Esc keeps it unchanged."
                       Foreground="{StaticResource Neutral600}" FontSize="11.5" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <Button Content="Apply" Style="{StaticResource BtnSecondary}" Command="{Binding ApplyHotkeyCommand}"
                    HorizontalAlignment="Left" Margin="0,10,0,0"/>

            <Border Height="2" Background="{StaticResource ColorDivider}" Margin="0,20"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Launches to tray, popup pre-warmed." FontSize="12" Foreground="{StaticResource Neutral600}" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" Foreground="{StaticResource Accent700}" FontWeight="SemiBold" FontSize="11.5"/>
        </StackPanel>
    </Grid>
</Window>
