<Window x:Class="PromptManager.Views.SearchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PromptManager.ViewModels"
        Title="Prompt Manager"
        Width="720"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Icon="pack://application:,,,/Resources/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- One prompt row: a group-header strip, or a clickable item row with title-highlight. -->
        <DataTemplate DataType="{x:Type vm:SearchResultRow}">
            <Grid>
                <TextBlock Text="{Binding GroupHeader, Converter={StaticResource UpperCaseConverter}}"
                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibilityConverter}}"
                           Padding="20,7" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Neutral600}"
                           Background="#0AF8F4F4"/>

                <Button Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                        Command="{Binding DataContext.ChooseRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RowBorder" Padding="20,11" BorderThickness="4,0,0,1"
                                    BorderBrush="{StaticResource DarkDividerFaint}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NumberText" Grid.Column="0" Text="{Binding DisplayNumber}"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Neutral200}">
                                            <Run Text="{Binding TitleBefore, Mode=OneWay}"/><Run
                                                Text="{Binding TitleMatch, Mode=OneWay}"
                                                Background="#38FF9783" Foreground="{StaticResource Accent400}"/><Run
                                                Text="{Binding TitleAfter, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="BodyText" Text="{Binding Prompt.Body}" FontSize="12"
                                                   Foreground="{StaticResource Neutral500}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MetaTextBlock" Grid.Column="2" Text="{Binding MetaText}"
                                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource Neutral600}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#0AF8F4F4"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource ColorAccent}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Neutral100}"/>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Neutral100}"/>
                                    <Setter TargetName="BodyText" Property="Foreground" Value="#D8F8F4F4"/>
                                    <Setter TargetName="MetaTextBlock" Property="Foreground" Value="#D8F8F4F4"/>
                                    <Setter TargetName="NumberText" Property="Foreground" Value="#BFF8F4F4"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Border Background="{StaticResource DarkBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="288"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewVisible}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- red top rule -->
            <Rectangle Grid.Row="0" Grid.ColumnSpan="2" Fill="{StaticResource ColorAccent}"/>

            <!-- header: icon + query + count badge -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="20,16" Visibility="{Binding IsHeaderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="10" Height="24" Fill="{StaticResource ColorAccent}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Search prompts" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Neutral700}"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsQueryEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22" FontWeight="SemiBold" Background="Transparent"
                             Foreground="{StaticResource Neutral100}" CaretBrush="{StaticResource ColorAccent}"
                             BorderThickness="0" Padding="0"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding CountBadgeText}" Foreground="{StaticResource Neutral600}"
                           FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>

            <!-- body: results list -->
            <ScrollViewer Grid.Row="2" Grid.Column="0" MaxHeight="480" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Rows}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DarkDividerFaint}"/>
            </ScrollViewer>

            <!-- body: preview pane -->
            <Grid Grid.Row="2" Grid.Column="1" Margin="18,15" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Preview" HorizontalAlignment="Left" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Neutral600}"/>
                    <TextBlock HorizontalAlignment="Right" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Accent400}">
                        <Run Text="{Binding PreviewCharCount, Mode=OneWay}"/><Run Text=" chars"/>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding SelectedPrompt.Body}" FontFamily="Consolas" FontSize="11.5"
                           LineHeight="19" Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"
                           MaxHeight="260" TextTrimming="CharacterEllipsis"/>

                <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource DarkDividerFaint}" Margin="0,14,0,10"/>

                <ItemsControl Grid.Row="3" ItemsSource="{Binding SelectedPrompt.Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#59F8F4F4" BorderThickness="1" Padding="7,2" Margin="0,0,6,6">
                                <TextBlock Text="{Binding Converter={StaticResource UpperCaseConverter}}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Neutral200}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- no-match state -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="24,20" MinWidth="672"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=NoMatch}">
                <TextBlock Text="Nothing matches that." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Neutral200}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Neutral500}" MaxWidth="480">
                    <Run Text="Press Enter to open the manager with &quot;"/><Run Text="{Binding Query, Mode=OneWay}" Foreground="{StaticResource Neutral200}"/><Run
                        Text="&quot; already in the title field, or keep typing to widen the search."/>
                </TextBlock>
            </StackPanel>

            <!-- first-run state -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="24,26,24,8" MinWidth="672"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=FirstRun}">
                <TextBlock Text="NO PROMPTS YET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent400}" Margin="0,0,0,10"/>
                <TextBlock Text="Three keys, and the prompt is on your clipboard." FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource Neutral100}" TextWrapping="Wrap" MaxWidth="380" Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,14,16,14">
                        <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBlock Text="Add prompts in the manager, or import a JSON file you already have." FontSize="12.5"
                                   Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,14,16,14">
                        <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBlock Text="Hit Ctrl + Space anywhere and type a few letters." FontSize="12.5"
                                   Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,14,0,14">
                        <TextBlock Text="03" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBlock Text="Enter copies. Paste with Ctrl + V wherever you are." FontSize="12.5"
                                   Foreground="{StaticResource Neutral300}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="⏎  Add first prompt" Style="{StaticResource BtnPrimary}"
                            Command="{Binding ConfirmCommand}" Margin="0,0,10,0"/>
                    <Button Content="I  Import JSON" Style="{StaticResource BtnSecondary}"
                            Foreground="{StaticResource Neutral200}" BorderBrush="#66F8F4F4"
                            Command="{Binding RequestImportCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- copied confirmation -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" MinWidth="672"
                  Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Copied}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="10" Height="52" Fill="{StaticResource ColorAccent}" Margin="0,0,20,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="COPIED TO CLIPBOARD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent400}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CopiedTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Neutral100}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="NOW PRESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Neutral500}" HorizontalAlignment="Right"/>
                        <TextBlock Text="Ctrl + V" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Neutral100}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Fill="{StaticResource ColorAccent}"/>
            </Grid>

            <!-- footer: keybind hints (Resting / Typing) -->
            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="20,10"
                  Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↑ ↓  Move" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,20,0"/>
                    <TextBlock Text="⏎  Copy" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,20,0"/>
                    <TextBlock Text="Alt + N  Jump" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,20,0"/>
                    <TextBlock Text="Esc  Close" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Copies to clipboard — paste with Ctrl + V" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Accent400}"/>
            </Grid>

            <!-- footer: no-match hints -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="20,10"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=NoMatch}">
                <TextBlock Text="⏎  New prompt" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}" Margin="0,0,20,0"/>
                <TextBlock Text="Esc  Close" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}"/>
            </StackPanel>

            <!-- footer: first-run hints -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="20,10"
                        Visibility="{Binding State, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=FirstRun}">
                <TextBlock Text="Esc  Close" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Neutral500}"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
