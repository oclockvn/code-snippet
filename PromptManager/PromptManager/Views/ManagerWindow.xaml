<Window x:Class="PromptManager.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Manager" Height="560" Width="900"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="New" Command="{Binding NewCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="Import..." Command="{Binding ImportCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="Export..." Command="{Binding ExportCommand}" Padding="10,4"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                      ItemsSource="{Binding Prompts}"
                      SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                      DisplayMemberPath="Title"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Title"/>
                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                <TextBlock Text="Tags (comma-separated)"/>
                <TextBox Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                <TextBlock Text="Body"/>
                <TextBox Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="260"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,4" Margin="0,0,6,0"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="14,4"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray"/>
    </Grid>
</Window>
