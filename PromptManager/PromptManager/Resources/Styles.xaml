<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Modernist palette — ported from _ds/.../styles.css ============ -->

    <SolidColorBrush x:Key="ColorBg" Color="#F3F2F2"/>
    <SolidColorBrush x:Key="ColorSurface" Color="#EAE9E9"/>
    <SolidColorBrush x:Key="ColorText" Color="#201E1D"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#EC3013"/>
    <SolidColorBrush x:Key="ColorDivider" Color="#66201E1D"/>

    <SolidColorBrush x:Key="Neutral100" Color="#F8F4F4"/>
    <SolidColorBrush x:Key="Neutral200" Color="#EAE7E7"/>
    <SolidColorBrush x:Key="Neutral300" Color="#D7D3D3"/>
    <SolidColorBrush x:Key="Neutral400" Color="#BAB6B6"/>
    <SolidColorBrush x:Key="Neutral500" Color="#9B9797"/>
    <SolidColorBrush x:Key="Neutral600" Color="#7D7979"/>
    <SolidColorBrush x:Key="Neutral700" Color="#605D5D"/>
    <SolidColorBrush x:Key="Neutral800" Color="#444141"/>
    <SolidColorBrush x:Key="Neutral900" Color="#2D2B2B"/>

    <SolidColorBrush x:Key="Accent100" Color="#FFF2EF"/>
    <SolidColorBrush x:Key="Accent200" Color="#FFE0D9"/>
    <SolidColorBrush x:Key="Accent300" Color="#FFC4B8"/>
    <SolidColorBrush x:Key="Accent400" Color="#FF9783"/>
    <SolidColorBrush x:Key="Accent500" Color="#FF563C"/>
    <SolidColorBrush x:Key="Accent600" Color="#DD2B0F"/>
    <SolidColorBrush x:Key="Accent700" Color="#AE1800"/>
    <SolidColorBrush x:Key="Accent800" Color="#7C1405"/>
    <SolidColorBrush x:Key="Accent900" Color="#4D170E"/>

    <!-- Dark popup surface -->
    <SolidColorBrush x:Key="DarkBg" Color="#201E1D"/>
    <SolidColorBrush x:Key="DarkDivider" Color="#47F8F4F4"/>
    <SolidColorBrush x:Key="DarkDividerFaint" Color="#1FF8F4F4"/>

    <FontFamily x:Key="HeadingFont">Segoe UI</FontFamily>

    <!-- ============ Buttons ============ -->

    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ColorText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorBg}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent600}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent700}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#12201E1D"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{StaticResource ColorAccent}"/>
        <Setter Property="Padding" Value="6,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1AEC3013"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Inputs ============ -->

    <Style x:Key="InputStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ColorAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Tags ============ -->

    <Style x:Key="TagOutlineBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style x:Key="TagOutlineText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorAccent}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ============ Toggle switch (CheckBox restyle) ============ -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="52" Height="26" Background="{StaticResource Neutral300}"
                            BorderBrush="{StaticResource ColorText}" BorderThickness="2" Padding="2">
                        <Border x:Name="Thumb" Width="18" Height="18" Background="{StaticResource ColorText}"
                                HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ColorAccent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
